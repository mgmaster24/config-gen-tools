# the base gitconfig.

[user]
	name = {{ .UserName }}
	email = {{ .Email }}
{{- if .SigningKey }}
	signingkey = {{ .SigningKey }}

[commit]
	gpgsign = true
{{- if .SSHSign }}

[gpg]
	format = ssh
{{- end }}
{{- end }}
