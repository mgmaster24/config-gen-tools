# Generated by gitforge. Do not edit — regenerate instead.
#
# Include this from your own ~/.gitconfig:
#
#   [include]
#       path = ~/.config/gitforge/gitconfig

[user]
	name = {{ .UserName }}
	email = {{ .Email }}
{{- if .SigningKey }}
	signingkey = {{ .SigningKey }}
{{- end }}
{{- if .SigningKey }}

[commit]
	gpgsign = true
{{- if .SSHSign }}

[gpg]
	format = ssh
{{- end }}
{{- end }}

[init]
{{- if .DefaultBranch }}
	defaultBranch = main
{{- end }}

[pull]
	rebase = {{ if .RebaseOnPull }}true{{ else }}false{{ end }}
{{- if .AutoStash }}

[rebase]
	autoStash = true
	autoSquash = true
{{- end }}
{{- if .Prune }}

[fetch]
	prune = true
	pruneTags = true
{{- end }}
{{- if .Rerere }}

[rerere]
	enabled = true
	autoUpdate = true
{{- end }}
{{- if .Zdiff3 }}

[merge]
	conflictStyle = zdiff3
{{- end }}
{{- if .Delta }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
{{- end }}
{{- if .Identities }}

# Directory-scoped identities. The trailing slash on each gitdir is
# load-bearing: without it git matches only that exact path, not the
# repositories beneath it.
{{- range .Identities }}

[includeIf "gitdir:{{ .Dir }}"]
	path = {{ .Path }}
{{- end }}
{{- end }}
